{
  // modelspec.org: the landing page plus registry pages generated at build time,
  // served as Cloudflare Workers static assets from dist/.
  //
  // dist/ is built by `npm run build` from public/ and the three registry indexes
  // (see README.md); it is not committed. The build command below is a guard, not
  // a build: it refuses to deploy (or dry-run) anything but a production build of
  // exactly dist/, and only warns on `wrangler dev`. Deploy with `npm run deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modelspec-org",
  "compatibility_date": "2026-06-02",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node scripts/check-build.mjs"
  },
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "modelspec.org", "custom_domain": true }
  ]
}
